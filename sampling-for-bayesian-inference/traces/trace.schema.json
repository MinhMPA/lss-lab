{
  "$id": "trace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "kind": {
        "not": {
          "enum": [
            "schematic",
            "inset"
          ]
        }
      }
    }
  },
  "properties": {
    "algorithm": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "settings": {
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "implementation",
        "version",
        "settings"
      ],
      "type": "object"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "counters": {
      "additionalProperties": false,
      "properties": {
        "geometric_candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "gradient_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "likelihood_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "neural_predictions": {
          "minimum": 0,
          "type": "integer"
        },
        "pilot_likelihood_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "training_operations": {
          "minimum": 0,
          "type": "integer"
        },
        "value_and_gradient_calls": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "likelihood_calls",
        "gradient_calls",
        "value_and_gradient_calls",
        "neural_predictions",
        "geometric_candidates",
        "training_operations",
        "pilot_likelihood_calls"
      ],
      "type": "object"
    },
    "diagnostics": {
      "additionalProperties": {
        "additionalProperties": false,
        "if": {
          "properties": {
            "valid": {
              "const": false
            }
          }
        },
        "properties": {
          "note": {
            "type": "string"
          },
          "reference": {
            "type": [
              "number",
              "null"
            ]
          },
          "valid": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "array",
              "object",
              "null"
            ]
          }
        },
        "required": [
          "value",
          "valid",
          "note",
          "reference"
        ],
        "then": {
          "properties": {
            "value": {
              "type": "null"
            }
          }
        },
        "type": "object"
      },
      "type": "object"
    },
    "display": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "enum": [
              "physical",
              "unit",
              "local",
              "whitened"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "rounding": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "subsampling": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subsampling",
        "rounding",
        "coordinates"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "reference",
        "importance",
        "rwm",
        "hmc",
        "nested",
        "ins_frozen",
        "nautilus",
        "funnel",
        "inset",
        "schematic"
      ]
    },
    "label": {
      "minLength": 1,
      "type": "string"
    },
    "mode": {
      "enum": [
        "actual",
        "pedagogical",
        "oracle",
        "reference",
        "schematic"
      ]
    },
    "model": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "hash": {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            "model_id": {
              "minLength": 1,
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "model_id",
            "params",
            "hash"
          ],
          "type": "object"
        }
      ]
    },
    "payload": {
      "type": "object"
    },
    "phases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "enum": [
              "warmup",
              "pilot",
              "exploration",
              "frozen-estimation",
              "production",
              "sampling"
            ]
          },
          "start": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "start",
          "end"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "minLength": 1,
          "type": "string"
        },
        "generator": {
          "minLength": 1,
          "type": "string"
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "git_sha": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            }
          ]
        },
        "packages": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "generator",
        "git_sha",
        "packages",
        "command"
      ],
      "type": "object"
    },
    "rng": {
      "additionalProperties": false,
      "properties": {
        "generator": {
          "minLength": 1,
          "type": "string"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "streams": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "seed",
        "generator",
        "streams"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "series": {
      "additionalProperties": {
        "items": {
          "type": [
            "number",
            "null"
          ]
        },
        "type": "array"
      },
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trace_id",
    "kind",
    "title",
    "label",
    "mode",
    "model",
    "algorithm",
    "rng",
    "phases",
    "counters",
    "diagnostics",
    "series",
    "display",
    "provenance",
    "payload",
    "content_hash"
  ],
  "then": {
    "properties": {
      "model": {
        "type": "object"
      }
    }
  },
  "title": "Sampling-demonstration trace envelope",
  "type": "object"
}
